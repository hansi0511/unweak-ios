    },
    "goal.handstandPushUp.stage1.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hüfte hoch, Körper im umgekehrten V. Du lernst, mit einem Teil deines Gewichts senkrecht zu drücken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hips high, body in an upside-down V. You learn to press vertically with part of your bodyweight."
          }
        }
      }
    },
    "goal.handstandPushUp.stage1.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schultern, Trizeps, obere Brust"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shoulders, triceps, upper chest"
          }
        }
      }
    },
    "goal.handstandPushUp.stage2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhöhter Pike-Liegestütz"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elevated pike push-up"
          }
        }
      }
    },
    "goal.handstandPushUp.stage2.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füße auf einem Kasten: mehr Gewicht auf den Händen und ein steilerer Winkel, näher am Handstand-Liegestütz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feet on a box: more weight on your hands and a steeper angle, closer to the handstand push-up."
          }
        }
      }
    },
    "goal.handstandPushUp.stage2.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schultern, Trizeps, Rumpf"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shoulders, triceps, core"
          }
        }
      }
    },
    "goal.handstandPushUp.stage3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handstand an der Wand halten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wall handstand hold"
          }
        }
      }
    },
    "goal.handstandPushUp.stage3.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das volle Körpergewicht kopfüber mit gestreckten Armen tragen. Gewöhnt dich an den Handstand und stärkt Schultern und Handgelenke."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carry your full bodyweight upside down on straight arms. Gets you used to the handstand and strengthens shoulders and wrists."
          }
        }
      }
    },
    "goal.handstandPushUp.stage3.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schultern, Trizeps, Rumpf, Handgelenke"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shoulders, triceps, core, wrists"
          }
        }
      }
    },
    "goal.handstandPushUp.stage4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halber Handstand-Liegestütz an der Wand"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Half wall handstand push-up"
          }
        }
      }
    },
    "goal.handstandPushUp.stage4.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erste Drückbewegungen mit vollem Körpergewicht, aber nur halb nach unten. Baut Kraft im oberen Teil der Bewegung auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First presses with your full bodyweight, but only halfway down. Builds strength in the top part of the movement."
          }
        }
      }
    },
    "goal.handstandPushUp.stage4.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
