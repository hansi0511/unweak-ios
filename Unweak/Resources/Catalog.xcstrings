          }
        }
      }
    },
    "goal.muscleUp.stage1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "10 Klimmzüge"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "10 pull-ups"
          }
        }
      }
    },
    "goal.muscleUp.stage1.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zehn saubere Klimmzüge am Stück: die Zugkraft, auf der der Muscle-up aufbaut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten clean pull-ups in a row: the pulling strength the muscle-up is built on."
          }
        }
      }
    },
    "goal.muscleUp.stage1.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latissimus, Bizeps, hintere Schultern, Griffkraft"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lats, biceps, rear shoulders, grip"
          }
        }
      }
    },
    "goal.muscleUp.stage2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klimmzug bis zur Brust"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chest-to-bar pull-up"
          }
        }
      }
    },
    "goal.muscleUp.stage2.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höher und schneller ziehen, bis die Brust die Stange berührt. Diese Höhe brauchst du, um über die Stange zu kommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pull higher and faster until your chest touches the bar. You need this height to get over the bar."
          }
        }
      }
    },
    "goal.muscleUp.stage2.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latissimus, Bizeps, mittlerer Rücken"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lats, biceps, middle back"
          }
        }
      }
    },
    "goal.muscleUp.stage3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "10 Dips"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "10 dips"
          }
        }
      }
    },
    "goal.muscleUp.stage3.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zehn Dips am Stück: die Drückkraft für den Teil über der Stange."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten dips in a row: the pushing strength for the part above the bar."
          }
        }
      }
    },
    "goal.muscleUp.stage3.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brust, Trizeps, vordere Schultern"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chest, triceps, front shoulders"
          }
        }
      }
    },
    "goal.muscleUp.stage4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Negativer Muscle-up"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Negative muscle-up"
          }
        }
      }
    },
    "goal.muscleUp.stage4.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Stütz über der Stange beginnen und langsam in den Hang ablassen. Lehrt den Übergang über die Stange unter Kontrolle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start in support above the bar and lower yourself slowly to the hang. Teaches the transition over the bar under control."
          }
        }
      }
    },
    "goal.muscleUp.stage4.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latissimus, Brust, Trizeps, Schultern"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lats, chest, triceps, shoulders"
          }
        }
      }
    },
    "goal.muscleUp.stage5" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muscle-up"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muscle-up"
          }
        }
      }
    },
    "goal.muscleUp.stage5.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen und Drücken in einer Bewegung vom Hang in den Stütz: das Ziel dieses Skills."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pull and push in one movement from the hang to the support: the goal of this skill."
          }
        }
      }
    },
    "goal.muscleUp.stage5.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latissimus, Brust, Trizeps, Schultern, Rumpf"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lats, chest, triceps, shoulders, core"
          }
        }
      }
    },
    "goal.pistolSquat.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine volle Kniebeuge auf einem Bein. Baut Kraft, Gleichgewicht und Beweglichkeit in Sprunggelenk und Hüfte auf, Bein für Bein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A full squat on one leg. Builds strength, balance and mobility in ankle and hip, one leg at a time."
          }
        }
      }
    },
    "goal.pistolSquat.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oberschenkel vorne, Gesäß, Adduktoren, Waden, Rumpf"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quadriceps, glutes, adductors, calves, core"
          }
        }
      }
    },
    "goal.pistolSquat.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pistol Squat"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pistol squat"
          }
        }
      }
    },
    "goal.pistolSquat.stage1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiefe Kniebeuge"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deep squat"
          }
        }
      }
    },
    "goal.pistolSquat.stage1.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit beiden Beinen ganz nach unten. Öffnet Sprunggelenke und Hüfte für die tiefe Position, die du später auf einem Bein brauchst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both legs, all the way down. Opens ankles and hips for the deep position you need later on one leg."
          }
        }
      }
    },
    "goal.pistolSquat.stage1.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oberschenkel vorne, Gesäß, Adduktoren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quadriceps, glutes, adductors"
          }
        }
      }
    },
    "goal.pistolSquat.stage2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausfallschritt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunge"
          }
        }
      }
    },
    "goal.pistolSquat.stage2.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das meiste Gewicht auf dem vorderen Bein, das hintere stützt. Erste Kraft und Balance auf einem Bein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Most of the weight on the front leg, the back leg supports. First single-leg strength and balance."
          }
        }
      }
    },
    "goal.pistolSquat.stage2.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oberschenkel vorne, Gesäß, Oberschenkel hinten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quadriceps, glutes, hamstrings"
          }
        }
      }
    },
    "goal.pistolSquat.stage3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pistol auf Kasten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Box pistol"
          }
        }
      }
    },
    "goal.pistolSquat.stage3.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf einem Bein auf einen Kasten setzen und wieder aufstehen. Der Kasten begrenzt die Tiefe, so wächst die Kraft Schritt für Schritt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit back onto a box on one leg and stand up again. The box limits the depth, so strength grows step by step."
          }
        }
      }
    },
    "goal.pistolSquat.stage3.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oberschenkel vorne, Gesäß, Rumpf"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quadriceps, glutes, core"
          }
        }
      }
    },
    "goal.pistolSquat.stage4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pistol mit Hilfe"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assisted pistol"
          }
        }
      }
    },
    "goal.pistolSquat.stage4.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volle Tiefe auf einem Bein, die Hände an einer Stange helfen beim Gleichgewicht. Kraft und Beweglichkeit ganz unten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full depth on one leg, the hands on a pole help with balance. Strength and mobility at the bottom."
          }
        }
      }
    },
    "goal.pistolSquat.stage4.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oberschenkel vorne, Gesäß, Waden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quadriceps, glutes, calves"
          }
        }
      }
    },
    "goal.pistolSquat.stage5" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voller Pistol Squat"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full pistol squat"
          }
        }
      }
    },
    "goal.pistolSquat.stage5.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf einem Bein ganz nach unten und wieder hoch, ohne Hilfe: das Ziel dieses Skills."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All the way down on one leg and back up, without help: the goal of this skill."
          }
        }
      }
    },
    "goal.pistolSquat.stage5.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
