          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwing ein Bein nach dem anderen hoch, bis die Fersen an der Wand liegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kick up one leg after the other until your heels rest against the wall."
          }
        }
      }
    },
    "exercise.wallHandstand.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drück den Boden weg, schließ die Beine und schau zu deinen Händen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push the floor away, squeeze your legs together and look at your hands."
          }
        }
      }
    },
    "goal.frontLever.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält den ganzen Körper waagrecht unter der Stange, mit gestreckten Armen. Baut Zugkraft und Ganzkörperspannung auf wie kaum eine andere Übung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holds the whole body horizontal under the bar with straight arms. Builds pulling strength and full-body tension like few other exercises."
          }
        }
      }
    },
    "goal.frontLever.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latissimus, Rumpf, hintere Schultern, Gesäß, Griffkraft"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lats, core, rear shoulders, glutes, grip"
          }
        }
      }
    },
    "goal.frontLever.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Front Lever"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Front lever"
          }
        }
      }
    },
    "goal.frontLever.stage1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuck"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuck"
          }
        }
      }
    },
    "goal.frontLever.stage1.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Knie an der Brust halten den Hebel kurz. Du lernst, den Körper mit gestreckten Armen waagrecht zu halten: die Basis für alle weiteren Stufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knees at the chest keep the lever short. You learn to hold your body horizontal with straight arms: the base for every further stage."
          }
        }
      }
    },
    "goal.frontLever.stage1.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latissimus, Rumpf, hintere Schultern"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lats, core, rear shoulders"
          }
        }
      }
    },
    "goal.frontLever.stage2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advanced Tuck"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advanced tuck"
          }
        }
      }
    },
    "goal.frontLever.stage2.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Rücken ist flach, die Oberschenkel zeigen nach oben. Der längere Hebel belastet Latissimus und Rumpf deutlich stärker."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The back is flat and the thighs point up. The longer lever puts clearly more load on lats and core."
          }
        }
      }
    },
    "goal.frontLever.stage2.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latissimus, Rumpf, hintere Schultern, unterer Rücken"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lats, core, rear shoulders, lower back"
          }
        }
      }
    },
    "goal.frontLever.stage3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Bein"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One leg"
          }
        }
      }
    },
    "goal.frontLever.stage3.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Bein ist gestreckt, das andere bleibt gebeugt. Überbrückt den großen Schritt vom Tuck zu den offenen Beinpositionen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One leg is straight, the other stays bent. Bridges the big step from the tuck to the open-leg positions."
          }
        }
      }
    },
    "goal.frontLever.stage3.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latissimus, Rumpf, Gesäß, Hüftbeuger"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lats, core, glutes, hip flexors"
          }
        }
      }
    },
    "goal.frontLever.stage4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Straddle"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Straddle"
          }
        }
      }
    },
    "goal.frontLever.stage4.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestreckte, gespreizte Beine: fast der volle Hebel, die Grätsche verkürzt ihn nur etwas. Kraft nahe am Ziel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Straight, spread legs: almost the full lever, but the spread shortens it a little. Strength close to the goal."
          }
        }
      }
    },
    "goal.frontLever.stage4.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latissimus, Rumpf, Gesäß, unterer Rücken, Adduktoren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lats, core, glutes, lower back, adductors"
          }
        }
      }
    },
    "goal.frontLever.stage5" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voller Front Lever"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full front lever"
          }
        }
      }
    },
    "goal.frontLever.stage5.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Körper gestreckt von Kopf bis Fuß und waagrecht, mit gestreckten Armen gehalten: das Ziel dieses Skills."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body straight from head to feet and horizontal, held with straight arms: the goal of this skill."
          }
        }
      }
    },
    "goal.frontLever.stage5.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
