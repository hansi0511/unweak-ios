          "stringUnit" : {
            "state" : "translated",
            "value" : "L-sit"
          }
        }
      }
    },
    "exercise.lSit.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setz die Hände neben der Hüfte auf Parallettes oder den Boden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place your hands on parallettes or the floor next to your hips."
          }
        }
      }
    },
    "exercise.lSit.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drück dich nach unten weg, streck die Ellbogen durch und heb die Hüfte an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press down, lock your elbows and lift your hips off the ground."
          }
        }
      }
    },
    "exercise.lSit.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heb die gestreckten Beine bis zur Waagrechten und halte die Position."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raise your straight legs until they are parallel to the floor and hold."
          }
        }
      }
    },
    "exercise.lunge.mistake1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das vordere Knie knickt nach innen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Front knee collapsing inwards."
          }
        }
      }
    },
    "exercise.lunge.mistake2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem Oberkörper weit nach vorn kippen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leaning far forward with the upper body."
          }
        }
      }
    },
    "exercise.lunge.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausfallschritt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunge"
          }
        }
      }
    },
    "exercise.lunge.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach einen großen Schritt nach vorn und halte den Oberkörper aufrecht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take a long step forward and keep your upper body upright."
          }
        }
      }
    },
    "exercise.lunge.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senk das hintere Knie, bis es fast den Boden berührt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lower your back knee until it almost touches the floor."
          }
        }
      }
    },
    "exercise.lunge.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drück dich über die vordere Ferse wieder hoch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push through your front heel to come back up."
          }
        }
      }
    },
    "exercise.muscleUp.mistake1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu langsam ziehen, um über die Stange zu kommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulling too slowly to get over the bar."
          }
        }
      }
    },
    "exercise.muscleUp.mistake2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen Arm vor dem anderen über die Stange bringen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Getting one arm over before the other."
          }
        }
      }
    },
    "exercise.muscleUp.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muscle-up"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muscle-up"
          }
        }
      }
    },
    "exercise.muscleUp.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Häng mit etwas engerem Griff und beginne mit einem kräftigen, explosiven Zug."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hang with a slightly narrower grip and start with a strong, explosive pull."
          }
        }
      }
    },
    "exercise.muscleUp.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobald die Brust an der Stange ist, lehn dich nach vorn und dreh die Handgelenke über die Stange."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As your chest reaches the bar, lean forward and turn your wrists over the bar."
          }
        }
      }
    },
    "exercise.muscleUp.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drück dich in den gestreckten Stütz über der Stange."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press up into a straight-arm support above the bar."
          }
        }
      }
    },
    "exercise.negativePullUp.mistake1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der unteren Hälfte schnell durchfallen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dropping quickly through the bottom half."
          }
        }
      }
    },
    "exercise.negativePullUp.mistake2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unten die Schultern locker hängen lassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letting the shoulders go loose at the bottom."
          }
        }
      }
    },
    "exercise.negativePullUp.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Negativer Klimmzug"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Negative pull-up"
          }
        }
      }
    },
    "exercise.negativePullUp.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spring oder steig hoch, bis das Kinn über der Stange ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jump or step up so your chin is above the bar."
          }
        }
      }
    },
    "exercise.negativePullUp.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass dich so langsam wie möglich ab, etwa drei bis fünf Sekunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lower yourself as slowly as you can, about three to five seconds."
          }
        }
      }
    },
    "exercise.negativePullUp.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass dich bis in den vollen Hang ab und steig für die nächste Wiederholung wieder hoch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reach a full hang, then step back up for the next repetition."
          }
        }
      }
    },
    "exercise.pikePushUp.mistake1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hüfte sinkt ab und es wird ein normaler Liegestütz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letting the hips drop into a normal push-up."
          }
        }
