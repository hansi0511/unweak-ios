    "exercise.pistolSquat.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell dich auf ein Bein und streck das andere gerade nach vorn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stand on one leg and hold the other leg straight out in front of you."
