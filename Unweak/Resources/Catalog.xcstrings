          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lats, core, glutes, rear shoulders"
          }
        }
      }
    },
    "goal.handstandPushUp.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ganze Körpergewicht kopfüber drücken. Baut starke, stabile Schultern und volle Kontrolle im Handstand auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressing your whole bodyweight upside down. Builds strong, stable shoulders and full control in the handstand."
          }
        }
      }
    },
    "goal.handstandPushUp.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schultern, Trizeps, obere Brust, oberer Rücken, Rumpf"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shoulders, triceps, upper chest, upper back, core"
          }
        }
      }
    },
    "goal.handstandPushUp.name" : {
      "extractionState" : "manual",
      "localizations" : {
