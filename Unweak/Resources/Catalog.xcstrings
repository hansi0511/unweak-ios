{
  "sourceLanguage" : "en",
  "strings" : {
    "exercise.dip.mistake1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schultern zu den Ohren ziehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shrugging the shoulders up to the ears."
          }
        }
      }
    },
    "exercise.dip.mistake2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiefer gehen, als die Schultern schmerzfrei mitmachen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Going deeper than your shoulders allow without pain."
          }
        }
      }
    },
    "exercise.dip.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dip"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dip"
          }
        }
      }
    },
    "exercise.dip.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stütz dich mit gestreckten Armen auf den Barren, die Schultern unten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Support yourself on parallel bars with straight arms and shoulders down."
          }
        }
      }
    },
    "exercise.dip.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beug die Ellbogen nach hinten und senk dich ab, bis die Oberarme etwa waagrecht sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bend your elbows backwards and lower until your upper arms are about parallel to the floor."
          }
        }
      }
    },
    "exercise.dip.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drück dich zurück in den gestreckten Stütz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press back up to straight arms."
          }
        }
      }
    },
    "exercise.kneePushUp.mistake1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hüfte hängt durch oder ragt nach oben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hips sagging or sticking up."
          }
        }
      }
    },
    "exercise.kneePushUp.mistake2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
