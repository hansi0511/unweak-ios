      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwing ein Bein nach dem anderen hoch, bis die Fersen an der Wand liegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kick up one leg after the other until your heels rest against the wall."
          }
        }
      }
    },
    "exercise.wallHandstand.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drück den Boden weg, schließ die Beine und schau zu deinen Händen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push the floor away, squeeze your legs together and look at your hands."
          }
        }
      }
    },
    "goal.frontLever.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du schwebst waagrecht unter der Stange, die Arme gestreckt, als hätte die Schwerkraft gerade Pause. Kaum eine Übung baut so viel Zugkraft und Ganzkörperspannung auf, und spektakulär aussehen tut sie auch noch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You float horizontally under the bar, arms straight, as if gravity had taken a day off. Few moves build pulling strength and full-body tension like this one, and it looks spectacular too."
          }
        }
      }
    },
    "goal.frontLever.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein breiter Rückenmuskel, der Latissimus, macht die Hauptarbeit und hält dich oben wie ein Regalbrett. Bauch und Po halten alles in einer geraden Linie, die hinteren Schultern sorgen für Ruhe und deine Hände halten fest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your wide back muscles (the lats) do most of the work and keep you up like a shelf. Your belly and glutes hold everything in one straight line, the backs of your shoulders keep you steady, and your hands hang on tight."
          }
        }
      }
    },
    "goal.frontLever.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Front Lever"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Front lever"
          }
        }
      }
    },
    "goal.frontLever.stage1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuck"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuck"
          }
        }
      }
    },
    "goal.frontLever.stage1.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Knie kuscheln sich an die Brust, du wirst zum kleinen Päckchen und hältst es waagrecht. So bleibt der Hebel kurz und du lernst die Position ganz in Ruhe kennen: der Startpunkt für alles, was noch kommt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knees snuggled up to your chest, you roll into a small ball and hold it level. That keeps the lever short and lets you feel the position safely: the starting point for everything that follows."
          }
        }
      }
    },
    "goal.frontLever.stage1.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier lernen Latissimus und Bauch, zusammenzuarbeiten, und die hinteren Schultern bekommen ihren ersten richtigen Job."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your lats and belly start working together here, and the backs of your shoulders get their first real job."
          }
        }
      }
    },
    "goal.frontLever.stage1.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knie zur Brust, Rücken gerade. Halte 10 Sekunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knees to your chest, back straight. Hold 10 seconds."
          }
        }
      }
    },
    "goal.frontLever.stage2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advanced Tuck"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advanced tuck"
          }
        }
      }
    },
    "goal.frontLever.stage2.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das gleiche kleine Päckchen, nur ist dein Rücken jetzt flach wie ein Tisch und die Oberschenkel zeigen in den Himmel. Der Hebel wird länger und fühlt sich deutlich schwerer an. Hier zahlt sich Geduld aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Same little package, but your back is now flat as a table and your thighs point to the sky. The lever gets longer, so it feels much heavier. Patience pays off here."
          }
        }
      }
    },
    "goal.frontLever.stage2.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latissimus und Bauch bekommen ordentlich mehr zu tun, und dein unterer Rücken hilft mit, damit er schön flach bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your lats and belly get a good deal more to do, and your lower back joins in to keep it nice and flat."
          }
        }
      }
    },
    "goal.frontLever.stage2.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hüfte gestreckt, Knie gebeugt, Rücken flach. Halte 10 Sekunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hips open, knees bent, back flat. Hold 10 seconds."
          }
        }
      }
    },
    "goal.frontLever.stage3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Bein"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One leg"
          }
        }
      }
    },
    "goal.frontLever.stage3.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Bein streckt sich aus, das andere bleibt angewinkelt. Das ist die freundliche Brücke zwischen den kleinen und den langen Positionen, und mit Beinwechsel kommt keine Seite zu kurz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One leg stretches out, the other stays tucked. This is the friendly bridge between the curled-up positions and the long ones, and you can switch legs to keep things fair."
          }
        }
      }
    },
    "goal.frontLever.stage3.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neben Latissimus und Bauch helfen jetzt auch Po und Hüftbeuger, das gestreckte Bein oben zu halten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besides your lats and belly, your glutes and hip flexors now help keep the straight leg up."
          }
        }
      }
    },
    "goal.frontLever.stage3.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Bein gestreckt, eins gebeugt. Halte 8 Sekunden pro Seite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One leg straight, one bent. Hold 8 seconds per side."
          }
        }
      }
    },
    "goal.frontLever.stage4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Straddle"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Straddle"
          }
        }
      }
    },
    "goal.frontLever.stage4.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide Beine gestreckt und weit gegrätscht, wie ein großes V. Die Grätsche macht den Hebel nur ein kleines bisschen kürzer als die volle Version: Du bist fast da!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both legs straight and wide apart, like a big V. The spread makes the lever just a bit shorter than the full version: you are almost there!"
          }
        }
      }
    },
    "goal.frontLever.stage4.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latissimus, Bauch und unterer Rücken arbeiten jetzt richtig, und Po und Innenseiten der Oberschenkel halten die Beine weit und gestreckt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your lats, belly and lower back are working at full power now, and your glutes and inner thighs keep the legs wide and straight."
          }
        }
      }
    },
    "goal.frontLever.stage4.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide Beine gestreckt und gegrätscht. Halte 6 Sekunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both legs straight and spread wide. Hold 6 seconds."
          }
        }
      }
    },
    "goal.frontLever.stage5" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voller Front Lever"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full front lever"
          }
        }
      }
    },
    "goal.frontLever.stage5.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beine zusammen, Körper gestreckt, schwebend unter der Stange. Genau dafür hast du trainiert. Genieß den Moment, mach ein Foto und sei stolz!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legs together, body straight, floating under the bar. This is the moment you have been training for. Enjoy it, take a photo, and be proud!"
          }
        }
      }
    },
    "goal.frontLever.stage5.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles auf einmal: Latissimus, Bauch, Po und hintere Schultern halten dich von Kopf bis Fuß wie ein Brett."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything at once: lats, belly, glutes and the backs of your shoulders hold you from head to toe like a plank of wood."
          }
        }
      }
    },
    "goal.frontLever.stage5.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Körper ganz gestreckt und waagrecht. Halte 5 Sekunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body fully straight and level. Hold 5 seconds."
          }
        }
      }
    },
    "goal.handstandPushUp.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopfüber drückst du deinen ganzen Körper hinauf und hinunter. Das baut starke, stabile Schultern auf, und die Welt sieht von da unten herrlich anders aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upside down, you press your whole body up and down. That builds strong, stable shoulders, and the world looks wonderfully different from down there."
          }
        }
      }
    },
    "goal.handstandPushUp.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Schultern sind hier die Stars, der Trizeps drückt fleißig mit. Obere Brust, oberer Rücken und Bauch sorgen dafür, dass alles schön übereinander bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your shoulders are the stars here, with your triceps pushing alongside. Upper chest, upper back and belly make sure everything stays stacked."
          }
        }
      }
    },
    "goal.handstandPushUp.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handstand-Liegestütz"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handstand push-up"
          }
        }
      }
    },
    "goal.handstandPushUp.stage1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pike-Liegestütz"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pike push-up"
          }
        }
      }
    },
    "goal.handstandPushUp.stage1.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hüfte geht hoch, dein Körper wird zum umgedrehten V, wie ein kleines Zelt. Du lernst, mit einem Teil deines Gewichts nach oben zu drücken, ganz sanft und ohne Höhenangst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hips up high, your body makes an upside-down V like a little tent. You learn to press straight up with part of your weight, gently and without any fear of heights."
          }
        }
      }
    },
    "goal.handstandPushUp.stage1.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor allem Schultern und Trizeps, mit ein bisschen Unterstützung von der oberen Brust."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostly your shoulders and triceps, with a little help from your upper chest."
          }
        }
      }
    },
    "goal.handstandPushUp.stage1.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hüfte hoch, Kopf zwischen die Hände. Schaffe 3 × 8."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hips high, head between your hands. Do 3 sets of 8."
          }
        }
      }
    },
    "goal.handstandPushUp.stage2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhöhter Pike-Liegestütz"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elevated pike push-up"
          }
        }
      }
    },
    "goal.handstandPushUp.stage2.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Füße klettern auf einen Kasten, so liegt mehr von dir auf den Händen. Der Winkel wird steiler und du schleichst dich näher an den echten Handstand-Liegestütz heran."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your feet climb onto a box, so more of you rests on your hands. The angle gets steeper and you creep closer to the real handstand push-up."
          }
        }
      }
    },
    "goal.handstandPushUp.stage2.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schultern und Trizeps bekommen mehr Gewicht zu tragen, und dein Bauch hält das Zelt schön stabil."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shoulders and triceps get more weight to carry, and your belly keeps the tent nice and steady."
          }
        }
      }
    },
    "goal.handstandPushUp.stage2.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füße auf dem Kasten, Hüfte über den Schultern. Schaffe 3 × 6."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feet on a box, hips above your shoulders. Do 3 sets of 6."
          }
        }
      }
    },
    "goal.handstandPushUp.stage3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handstand an der Wand halten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wall handstand hold"
          }
        }
      }
    },
    "goal.handstandPushUp.stage3.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hochschwingen und an die Wand lehnen, die Wand hält dir den Rücken frei! Du gewöhnst dich ans Kopfüber-Sein und trägst dein volles Gewicht auf gestreckten Armen. Ruhig atmen und lächeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kick up and lean against the wall, the wall has your back! You get used to being upside down and carry your full weight on straight arms. Breathe calmly and smile."
          }
        }
      }
    },
    "goal.handstandPushUp.stage3.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schultern und Trizeps tragen dich, der Bauch hält dich gerade, und deine Handgelenke werden Tag für Tag kräftiger."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shoulders and triceps hold you up, your belly keeps you straight, and your wrists get stronger day by day."
          }
        }
      }
    },
    "goal.handstandPushUp.stage3.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rücken zur Wand, Arme gestreckt. Halte 30 Sekunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Back to the wall, arms straight. Hold 30 seconds."
          }
        }
      }
    },
    "goal.handstandPushUp.stage4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halber Handstand-Liegestütz an der Wand"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Half wall handstand push-up"
          }
        }
      }
    },
    "goal.handstandPushUp.stage4.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine ersten echten Drückbewegungen kopfüber, vorerst nur bis zur Hälfte. Kleiner Weg, großer Schritt: Hier wächst die Kraft für die ganze Bewegung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your first real presses upside down, only halfway down for now. Small range, big step: this is where the strength for the full movement grows."
          }
        }
      }
    },
    "goal.handstandPushUp.stage4.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schultern und Trizeps drücken jetzt dein volles Gewicht, und dein oberer Rücken passt auf deine Schultern auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shoulders and triceps press your full weight now, and your upper back keeps your shoulders safe."
          }
        }
      }
    },
    "goal.handstandPushUp.stage4.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An der Wand halb ablassen und hochdrücken. Schaffe 3 × 5."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lower halfway down the wall and press up. Do 3 sets of 5."
          }
        }
      }
    },
    "goal.handstandPushUp.stage5" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voller Handstand-Liegestütz an der Wand"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full wall handstand push-up"
          }
        }
      }
    },
    "goal.handstandPushUp.stage5.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Kopf sanft bis zum Boden und wieder ganz hoch zu gestreckten Armen, mit deinem ganzen Gewicht. Das ist das Ziel dieses Skills: Geschafft!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Head gently down to the floor and all the way back up to straight arms, with your whole weight. That is the goal of this skill: you did it!"
          }
        }
      }
    },
    "goal.handstandPushUp.stage5.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schultern, Trizeps, obere Brust und Bauch, alle zusammen als ein starkes Team."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shoulders, triceps, upper chest and belly, all working together as one strong team."
          }
        }
      }
    },
    "goal.handstandPushUp.stage5.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopf bis zum Boden und ganz hoch. Schaffe 3 × 3."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Head to the floor and all the way up. Do 3 sets of 3."
          }
        }
      }
    },
    "goal.lSit30.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dreißig Sekunden in der Luft sitzen, die Beine gestreckt vor dir wie ein großes L. Das schenkt dir tolle Kompressionskraft und ruhige Schultern, eine prima Basis für viele Turnelemente."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thirty seconds sitting in the air, legs straight out in front of you like a capital L. It builds wonderful compression strength and steady shoulders, a great base for many gymnastics moves."
          }
        }
      }
    },
    "goal.lSit30.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hüftbeuger und Bauch heben deine Beine, während Trizeps und Schultern dich nach oben und weg vom Boden drücken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your hip flexors and belly lift your legs, while your triceps and shoulders push you up and away from the floor."
          }
        }
      }
    },
    "goal.lSit30.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-Sit 30 s"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-sit 30 s"
          }
        }
      }
    },
    "goal.muscleUp.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus dem Hang unter der Stange in einem einzigen Schwung oben drauf in den Stütz. Das verbindet explosives Ziehen und Drücken und fühlt sich ein bisschen an wie Fliegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From hanging below the bar to sitting on top of it in one smooth swoop. It combines explosive pulling and pushing, and it feels like flying a little."
          }
        }
      }
    },
    "goal.muscleUp.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latissimus und Bizeps ziehen dich hoch, Brust, Trizeps und Schultern drücken dich oben drüber, und dein Bauch hält alles zusammen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lats and biceps pull you up, chest, triceps and shoulders push you over the top, and your belly ties it all together."
          }
        }
      }
    },
    "goal.muscleUp.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muscle-up"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muscle-up"
          }
        }
      }
    },
    "goal.muscleUp.stage1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "10 Klimmzüge"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "10 pull-ups"
          }
        }
      }
    },
    "goal.muscleUp.stage1.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zehn saubere Klimmzüge am Stück, jedes Mal mit dem Kinn über die Stange. Das ist die Zugkraft, auf der dein Muscle-up später aufbaut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten clean pull-ups in a row, chin over the bar each time. This is the pulling strength your muscle-up will be built on."
          }
        }
      }
    },
    "goal.muscleUp.stage1.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latissimus und Bizeps ziehen, die hinteren Schultern helfen mit, und dein Griff wird mit jeder Wiederholung stärker."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your lats and biceps pull, the backs of your shoulders help, and your grip gets stronger with every rep."
          }
        }
      }
    },
    "goal.muscleUp.stage1.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kinn über die Stange, ohne Schwung. Schaffe 10 am Stück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chin over the bar, no swinging. Do 10 in a row."
          }
        }
      }
    },
    "goal.muscleUp.stage2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klimmzug bis zur Brust"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chest-to-bar pull-up"
          }
        }
      }
    },
    "goal.muscleUp.stage2.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh höher und ein bisschen schneller, bis deine Brust die Stange umarmt. Genau diese Höhe brauchst du später, um über die Stange zu kommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pull higher and a little faster, until your chest gives the bar a hug. You need exactly this height to get over the bar later on."
          }
        }
      }
    },
    "goal.muscleUp.stage2.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latissimus und Bizeps ziehen extra kräftig, und dein mittlerer Rücken zieht die Schulterblätter zusammen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lats and biceps pull extra hard, and your middle back squeezes your shoulder blades together."
          }
        }
      }
    },
    "goal.muscleUp.stage2.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh, bis die Brust die Stange berührt. Schaffe 3 × 5."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pull until your chest touches the bar. Do 3 sets of 5."
          }
        }
      }
    },
    "goal.muscleUp.stage3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "10 Dips"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "10 dips"
          }
        }
      }
    },
    "goal.muscleUp.stage3.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zehn Dips am Stück am Barren. Sie schenken dir die Drückkraft für den Teil des Muscle-ups, der über der Stange passiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten dips in a row on parallel bars. They give you the pushing strength for the part of the muscle-up that happens above the bar."
          }
        }
      }
    },
    "goal.muscleUp.stage3.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brust, Trizeps und vordere Schultern drücken dich vom Barren nach oben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chest, triceps and the fronts of your shoulders push you up from the bars."
          }
        }
      }
    },
    "goal.muscleUp.stage3.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schultern unten, Oberarme unten waagrecht. Schaffe 10 am Stück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shoulders down, upper arms level at the bottom. Do 10 in a row."
          }
        }
      }
    },
    "goal.muscleUp.stage4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Negativer Muscle-up"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Negative muscle-up"
          }
        }
      }
    },
    "goal.muscleUp.stage4.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oben auf der Stange beginnen und dich langsam, ganz langsam in den Hang ablassen. So lernt dein Körper den kniffligen Übergang über die Stange, in Ruhe und unter Kontrolle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start on top of the bar and lower yourself slowly, slowly into the hang. That is how your body learns the tricky transition over the bar, calmly and under control."
          }
        }
      }
    },
    "goal.muscleUp.stage4.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latissimus, Brust, Trizeps und Schultern arbeiten alle, während du dich langsam nach unten abbremst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lats, chest, triceps and shoulders all work while slowly braking your way down."
          }
        }
      }
    },
    "goal.muscleUp.stage4.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus dem Stütz über der Stange in 5 Sekunden ablassen. Schaffe 3 × 3."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From support above the bar, lower in 5 seconds. Do 3 sets of 3."
          }
        }
      }
    },
    "goal.muscleUp.stage5" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muscle-up"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muscle-up"
          }
        }
      }
    },
    "goal.muscleUp.stage5.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen, durchschwingen, drücken: vom Hang bis oben auf die Stange in einem Zug. Das ist das Ziel dieses Skills. Willkommen da oben!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pull, swing through and push: from hanging to sitting on top of the bar in one go. That is the goal of this skill. Welcome up there!"
          }
        }
      }
    },
    "goal.muscleUp.stage5.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latissimus, Brust, Trizeps, Schultern und Bauch, dein ganzer Oberkörper in einem großen Teamwork."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lats, chest, triceps, shoulders and belly, your whole upper body in one big team move."
          }
        }
      }
    },
    "goal.muscleUp.stage5.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen, über die Stange drehen, in den Stütz drücken. Schaffe 1 saubere Wiederholung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pull, turn over the bar, press to support. Do 1 clean rep."
          }
        }
      }
    },
    "goal.pistolSquat.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine volle Kniebeuge auf nur einem Bein, das andere streckt sich nach vorne. Das baut Kraft, Gleichgewicht und Beweglichkeit in Sprunggelenk und Hüfte auf, und jedes Bein bekommt sein eigenes kleines Abenteuer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A full squat on just one leg, the other one stretched out in front. It builds strength, balance and mobility in ankles and hips, and every leg gets its own little adventure."
          }
        }
      }
    },
    "goal.pistolSquat.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oberschenkel vorne und Po machen die schwere Arbeit, Innenseiten der Oberschenkel und Waden halten dich in Balance, und dein Bauch hält dich aufrecht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The fronts of your thighs and your glutes do the heavy lifting, your inner thighs and calves keep you balanced, and your belly keeps you upright."
          }
        }
      }
    },
    "goal.pistolSquat.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pistol Squat"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pistol squat"
          }
        }
      }
    },
    "goal.pistolSquat.stage1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiefe Kniebeuge"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deep squat"
          }
        }
      }
    },
    "goal.pistolSquat.stage1.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit beiden Beinen ganz tief runter, als würdest du dich auf einen winzigen Hocker setzen. Das öffnet Sprunggelenke und Hüfte für die tiefe Position, die du später auf einem Bein brauchst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sink all the way down on both legs, as if sitting on a tiny stool. This opens up your ankles and hips for the deep position you will need later on one leg."
          }
        }
      }
    },
    "goal.pistolSquat.stage1.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oberschenkel vorne, Po und Innenseiten der Oberschenkel, vorerst noch auf beiden Beinen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fronts of the thighs, glutes and inner thighs, all on both legs for now."
          }
        }
      }
    },
    "goal.pistolSquat.stage1.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fersen am Boden, ganz nach unten. Halte unten 30 Sekunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feet flat, all the way down. Hold the bottom 30 seconds."
          }
        }
      }
    },
    "goal.pistolSquat.stage2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausfallschritt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunge"
          }
        }
      }
    },
    "goal.pistolSquat.stage2.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein großer Schritt nach vorn und runter. Das meiste Gewicht liegt auf dem vorderen Bein, das hintere hilft ein wenig: dein erster Vorgeschmack auf Kraft und Balance auf einem Bein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A big step forward and down. Most of your weight rests on the front leg while the back one lends a hand: your first taste of single-leg strength and balance."
          }
        }
      }
    },
    "goal.pistolSquat.stage2.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oberschenkel vorne und hinten und dein Po, wobei das vordere Bein den Großteil übernimmt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fronts and backs of the thighs and your glutes, with the front leg doing most of the work."
          }
        }
      }
    },
    "goal.pistolSquat.stage2.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorderes Knie über dem Fuß. Schaffe 3 × 10 pro Bein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Front knee over the foot. Do 3 sets of 10 per leg."
          }
        }
      }
    },
    "goal.pistolSquat.stage3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pistol auf Kasten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Box pistol"
          }
        }
      }
    },
    "goal.pistolSquat.stage3.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf einem Bein auf einen Kasten setzen und wieder aufstehen. Der Kasten fängt dich auf und bestimmt, wie tief es geht, so kann deine Kraft Schritt für Schritt wachsen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit down onto a box on one leg and stand up again. The box catches you and decides how deep you go, so your strength can grow step by step."
          }
        }
      }
    },
    "goal.pistolSquat.stage3.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oberschenkel vorne und Po auf einem Bein, und dein Bauch hält dich aufrecht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fronts of the thighs and glutes on one leg, with your belly keeping you upright."
          }
        }
      }
    },
    "goal.pistolSquat.stage3.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf einem Bein auf den Kasten setzen. Schaffe 3 × 5 pro Bein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit back onto the box on one leg. Do 3 sets of 5 per leg."
          }
        }
      }
    },
    "goal.pistolSquat.stage4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pistol mit Hilfe"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assisted pistol"
          }
        }
      }
    },
    "goal.pistolSquat.stage4.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf einem Bein ganz nach unten, während deine Hände sich an einer Stange oder am Türrahmen festhalten. Kraft und Beweglichkeit ganz unten, mit einem freundlichen Helfer an deiner Seite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All the way down on one leg, while your hands hold on to a pole or doorframe for balance. Strength and mobility at the bottom, with a friendly helper by your side."
          }
        }
      }
    },
    "goal.pistolSquat.stage4.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oberschenkel vorne, Po und Waden, vor allem ganz unten in der Tiefe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fronts of the thighs, glutes and calves, especially down at the very bottom."
          }
        }
      }
    },
    "goal.pistolSquat.stage4.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An der Stange festhalten, ganz runter. Schaffe 3 × 5 pro Bein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold the pole, go all the way down. Do 3 sets of 5 per leg."
          }
        }
      }
    },
    "goal.pistolSquat.stage5" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voller Pistol Squat"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full pistol squat"
          }
        }
      }
    },
    "goal.pistolSquat.stage5.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf einem Bein ganz runter und wieder hoch, ganz ohne Hilfe. Das ist das Ziel dieses Skills: Ein bisschen wackeln ist erlaubt, feiern ist Pflicht!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All the way down on one leg and back up, without any help. That is the goal of this skill: wobbling a little is allowed, celebrating is required!"
          }
        }
      }
    },
    "goal.pistolSquat.stage5.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oberschenkel vorne, Po, Innenseiten der Oberschenkel und Bauch, alle machen gemeinsam mit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fronts of the thighs, glutes, inner thighs and belly, all doing their part together."
          }
        }
      }
    },
    "goal.pistolSquat.stage5.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganz runter und hoch, ohne Hilfe. Schaffe 3 pro Bein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All the way down and up, no help. Do 3 per leg."
          }
        }
      }
    },
    "goal.plank5Min.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fünf ganze Minuten, gerade wie ein Brett auf den Unterarmen. Klingt einfach, schenkt dir aber einen Rumpf mit Ausdauer, eine bessere Haltung und einen zufriedeneren unteren Rücken im Alltag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Five whole minutes, straight as a board on your forearms. It sounds simple, but it builds a trunk with staying power, better posture, and a happier lower back in everyday life."
          }
        }
      }
    },
    "goal.plank5Min.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine tiefen Bauchmuskeln legen sich wie ein Korsett um dich, die geraden Bauchmuskeln halten die Linie, und Schultern und Po helfen leise mit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your deep belly muscles wrap around you like a corset, your six-pack muscles keep the line, and your shoulders and glutes quietly help out."
          }
        }
      }
    },
    "goal.plank5Min.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plank 5 min"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plank 5 min"
          }
        }
      }
    },
