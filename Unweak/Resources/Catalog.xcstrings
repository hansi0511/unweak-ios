    "exercise.advancedTuckFrontLever.mistake1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runder Rücken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rounded back."
          }
        }
      }
    },
    "exercise.advancedTuckFrontLever.mistake2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Arme beugen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bending the arms."
          }
        }
      }
    },
    "exercise.advancedTuckFrontLever.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advanced Tuck Front Lever"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advanced tuck front lever"
          }
        }
      }
    },
    "exercise.advancedTuckFrontLever.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geh unter der Stange in den Tuck Front Lever."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get into a tuck front lever under the bar."
          }
        }
      }
    },
    "exercise.advancedTuckFrontLever.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streck die Hüfte, bis der Rücken flach ist, die Knie bleiben gebeugt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open your hips until your back is flat, knees still bent."
          }
        }
      }
    },
    "exercise.advancedTuckFrontLever.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drück die Stange mit gestreckten Armen nach unten und halte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press the bar down with straight arms and hold."
          }
        }
      }
    },
    "exercise.assistedPistol.mistake1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dich mit den Armen hochziehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulling yourself up with the arms."
          }
        }
      }
    },
    "exercise.assistedPistol.mistake2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ferse des Standbeins hebt ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heel of the standing foot lifting."
          }
        }
      }
    },
    "exercise.assistedPistol.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pistol mit Hilfe"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assisted pistol"
          }
        }
      }
    },
    "exercise.assistedPistol.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell dich auf einem Bein neben eine Stange oder einen Türrahmen und halt dich leicht fest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stand on one leg next to a pole or door frame and hold it lightly."
          }
        }
      }
    },
    "exercise.assistedPistol.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geh auf dem Standbein ganz nach unten, das andere Bein gestreckt nach vorn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sink all the way down on the standing leg, the other leg straight out in front."
          }
        }
      }
    },
    "exercise.assistedPistol.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steh wieder auf und nutz die Hände nur so viel wie nötig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stand back up, using your hands only as much as you need."
          }
        }
      }
    },
    "exercise.benchDip.mistake1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ellbogen zeigen zur Seite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elbows pointing out to the sides."
          }
        }
      }
    },
    "exercise.benchDip.mistake2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hüfte wandert weit von der Bank weg."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hips drifting far away from the bench."
          }
        }
      }
    },
    "exercise.benchDip.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bank-Dip"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bench dip"
          }
        }
      }
    },
    "exercise.benchDip.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setz dich auf die Kante einer Bank, die Hände neben der Hüfte, und schieb die Hüfte nach vorn von der Bank."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit on the edge of a bench, hands next to your hips, and slide your hips forward off it."
          }
        }
      }
    },
    "exercise.benchDip.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beug die Ellbogen nach hinten und senk die Hüfte, bis die Oberarme etwa waagrecht sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bend your elbows straight back and lower your hips until your upper arms are about level."
          }
        }
      }
    },
    "exercise.benchDip.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drück dich hoch, bis die Arme gestreckt sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press back up until your arms are straight."
          }
        }
      }
    },
    "exercise.boxPistol.mistake1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf den Kasten plumpsen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dropping onto the box."
          }
        }
      }
    },
    "exercise.boxPistol.mistake2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Knie knickt nach innen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knee caving inwards."
          }
        }
      }
    },
    "exercise.boxPistol.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pistol auf Kasten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Box pistol"
          }
        }
      }
    },
    "exercise.boxPistol.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell dich auf einem Bein vor einen Kasten, das andere Bein gestreckt nach vorn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stand on one leg in front of a box, the other leg straight out in front."
          }
        }
      }
    },
    "exercise.boxPistol.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setz dich langsam nach hinten auf den Kasten, die Arme nach vorn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit back slowly onto the box, arms reaching forward."
          }
        }
      }
    },
    "exercise.boxPistol.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steh auf demselben Bein wieder auf, ohne Schwung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stand up on the same leg without rocking."
          }
        }
      }
    },
    "exercise.bulgarianSplitSquat.mistake1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das vordere Knie knickt nach innen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Front knee collapsing inwards."
          }
        }
      }
    },
    "exercise.bulgarianSplitSquat.mistake2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu nah an der Bank stehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standing too close to the bench."
          }
        }
      }
    },
    "exercise.bulgarianSplitSquat.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bulgarische Kniebeuge"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bulgarian split squat"
          }
        }
      }
    },
    "exercise.bulgarianSplitSquat.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell dich einen großen Schritt vor eine Bank und leg den Rist des hinteren Fußes darauf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stand a big step in front of a bench and put the top of your back foot on it."
          }
        }
      }
    },
    "exercise.bulgarianSplitSquat.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senk das hintere Knie Richtung Boden, der Oberkörper bleibt aufrecht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lower your back knee towards the floor, upper body upright."
          }
        }
      }
    },
    "exercise.bulgarianSplitSquat.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drück dich über die vordere Ferse wieder hoch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push through your front heel to stand back up."
          }
        }
      }
    },
    "exercise.chestToBarPullUp.mistake1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem Kinn an der Stange aufhören."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopping with the chin at the bar."
          }
        }
      }
    },
    "exercise.chestToBarPullUp.mistake2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit den Beinen strampeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kicking with the legs."
          }
        }
      }
    },
    "exercise.chestToBarPullUp.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klimmzug bis zur Brust"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chest-to-bar pull-up"
          }
        }
      }
    },
    "exercise.chestToBarPullUp.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Häng an der Stange, die Hände etwas breiter als schulterbreit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hang from the bar with hands slightly wider than your shoulders."
          }
        }
      }
    },
    "exercise.chestToBarPullUp.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh kräftig und zügig, leicht nach hinten gelehnt, bis die Brust die Stange berührt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pull hard and fast, leaning back slightly, until your chest touches the bar."
          }
        }
      }
    },
    "exercise.chestToBarPullUp.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass dich kontrolliert bis in den vollen Hang ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lower yourself under control to a full hang."
          }
        }
      }
    },
    "exercise.chinUp.mistake1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit den Beinen Schwung holen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swinging the legs for momentum."
          }
        }
      }
    },
    "exercise.chinUp.mistake2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur halb hochziehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only pulling halfway up."
          }
        }
      }
    },
    "exercise.chinUp.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chin-up"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chin-up"
          }
        }
      }
    },
    "exercise.chinUp.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Häng an der Stange, die Handflächen zeigen zu dir, die Hände schulterbreit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hang from the bar with your palms facing you, hands shoulder-width apart."
          }
        }
      }
    },
    "exercise.chinUp.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh die Brust zur Stange, bis das Kinn darüber ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pull your chest towards the bar until your chin is above it."
          }
        }
      }
    },
    "exercise.chinUp.step3" : {
      "extractionState" : "manual",
      "localizations" : {
