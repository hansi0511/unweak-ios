    "exercise.dip.mistake1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schultern zu den Ohren ziehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shrugging the shoulders up to the ears."
          }
        }
      }
    },
    "exercise.dip.mistake2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiefer gehen, als die Schultern schmerzfrei mitmachen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Going deeper than your shoulders allow without pain."
          }
        }
      }
    },
    "exercise.dip.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dip"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dip"
          }
        }
      }
    },
    "exercise.dip.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stütz dich mit gestreckten Armen auf den Barren, die Schultern unten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Support yourself on parallel bars with straight arms and shoulders down."
          }
        }
      }
    },
    "exercise.dip.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beug die Ellbogen nach hinten und senk dich ab, bis die Oberarme etwa waagrecht sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bend your elbows backwards and lower until your upper arms are about parallel to the floor."
          }
        }
      }
    },
    "exercise.dip.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drück dich zurück in den gestreckten Stütz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press back up to straight arms."
          }
        }
      }
    },
    "exercise.kneePushUp.mistake1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hüfte hängt durch oder ragt nach oben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hips sagging or sticking up."
          }
        }
      }
    },
    "exercise.kneePushUp.mistake2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ellbogen stehen weit zur Seite ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elbows flaring straight out to the sides."
          }
        }
      }
    },
    "exercise.kneePushUp.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knie-Liegestütz"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knee push-up"
          }
        }
      }
    },
    "exercise.kneePushUp.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knie dich hin und setz die Hände etwas breiter als schulterbreit auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kneel and place your hands slightly wider than shoulder width."
          }
        }
      }
    },
    "exercise.kneePushUp.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte Knie, Hüfte und Kopf in einer Linie und spann den Bauch an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep a straight line from knees to head and tighten your core."
          }
        }
      }
    },
    "exercise.kneePushUp.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senk die Brust zum Boden und drück dich wieder hoch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lower your chest towards the floor and push back up."
          }
        }
      }
    },
    "exercise.kneeRaise.mistake1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor und zurück schwingen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swinging back and forth."
          }
        }
      }
    },
    "exercise.kneeRaise.mistake2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur die Füße statt der Knie anheben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only lifting the feet, not the knees."
          }
        }
      }
    },
    "exercise.kneeRaise.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hängendes Knieheben"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanging knee raise"
          }
        }
      }
    },
    "exercise.kneeRaise.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Häng mit gestreckten Armen und aktiven Schultern an der Stange."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hang from the bar with straight arms and active shoulders."
          }
        }
      }
    },
    "exercise.kneeRaise.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh die Knie hoch, bis die Oberschenkel mindestens waagrecht sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raise your knees until your thighs are at least horizontal."
          }
        }
      }
    },
    "exercise.kneeRaise.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senk die Beine langsam ab, ohne zu schwingen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lower your legs slowly without swinging."
          }
        }
      }
    },
    "exercise.lSit.mistake1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebeugte Knie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bent knees."
          }
        }
      }
    },
    "exercise.lSit.mistake2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hochgezogene Schultern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shoulders shrugged up."
          }
        }
      }
    },
    "exercise.lSit.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-Sit"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-sit"
          }
        }
      }
    },
    "exercise.lSit.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setz die Hände neben der Hüfte auf Parallettes oder den Boden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place your hands on parallettes or the floor next to your hips."
          }
        }
      }
    },
    "exercise.lSit.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drück dich nach unten weg, streck die Ellbogen durch und heb die Hüfte an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press down, lock your elbows and lift your hips off the ground."
          }
        }
      }
    },
    "exercise.lSit.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heb die gestreckten Beine bis zur Waagrechten und halte die Position."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raise your straight legs until they are parallel to the floor and hold."
          }
        }
      }
    },
    "exercise.lunge.mistake1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das vordere Knie knickt nach innen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Front knee collapsing inwards."
          }
        }
      }
    },
    "exercise.lunge.mistake2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem Oberkörper weit nach vorn kippen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leaning far forward with the upper body."
          }
        }
      }
    },
    "exercise.lunge.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausfallschritt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunge"
          }
        }
      }
    },
    "exercise.lunge.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach einen großen Schritt nach vorn und halte den Oberkörper aufrecht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take a long step forward and keep your upper body upright."
          }
        }
      }
    },
    "exercise.lunge.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senk das hintere Knie, bis es fast den Boden berührt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lower your back knee until it almost touches the floor."
          }
        }
      }
    },
    "exercise.lunge.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drück dich über die vordere Ferse wieder hoch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push through your front heel to come back up."
          }
        }
      }
    },
    "exercise.muscleUp.mistake1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu langsam ziehen, um über die Stange zu kommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulling too slowly to get over the bar."
          }
        }
      }
    },
    "exercise.muscleUp.mistake2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen Arm vor dem anderen über die Stange bringen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Getting one arm over before the other."
          }
        }
      }
    },
    "exercise.muscleUp.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muscle-up"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muscle-up"
          }
        }
      }
    },
    "exercise.muscleUp.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Häng mit etwas engerem Griff und beginne mit einem kräftigen, explosiven Zug."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hang with a slightly narrower grip and start with a strong, explosive pull."
          }
        }
      }
    },
    "exercise.muscleUp.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobald die Brust an der Stange ist, lehn dich nach vorn und dreh die Handgelenke über die Stange."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As your chest reaches the bar, lean forward and turn your wrists over the bar."
          }
        }
      }
    },
    "exercise.muscleUp.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drück dich in den gestreckten Stütz über der Stange."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press up into a straight-arm support above the bar."
          }
        }
      }
    },
    "exercise.negativePullUp.mistake1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der unteren Hälfte schnell durchfallen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dropping quickly through the bottom half."
          }
        }
      }
    },
    "exercise.negativePullUp.mistake2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unten die Schultern locker hängen lassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letting the shoulders go loose at the bottom."
          }
        }
      }
    },
    "exercise.negativePullUp.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Negativer Klimmzug"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Negative pull-up"
          }
        }
      }
    },
    "exercise.negativePullUp.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spring oder steig hoch, bis das Kinn über der Stange ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jump or step up so your chin is above the bar."
          }
        }
      }
    },
    "exercise.negativePullUp.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass dich so langsam wie möglich ab, etwa drei bis fünf Sekunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lower yourself as slowly as you can, about three to five seconds."
          }
        }
      }
    },
    "exercise.negativePullUp.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass dich bis in den vollen Hang ab und steig für die nächste Wiederholung wieder hoch."
          }
        },
        "en" : {
          "stringUnit" : {
