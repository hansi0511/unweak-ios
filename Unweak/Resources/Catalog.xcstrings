    },
    "exercise.pikePushUp.mistake2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gesicht statt des Scheitels absenken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lowering the face instead of the top of the head."
          }
        }
      }
    },
    "exercise.pikePushUp.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pike-Liegestütz"
