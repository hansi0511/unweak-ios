          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shoulders, triceps, upper back"
          }
        }
      }
    },
    "goal.handstandPushUp.stage5" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voller Handstand-Liegestütz an der Wand"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full wall handstand push-up"
          }
        }
      }
    },
    "goal.handstandPushUp.stage5.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem Kopf bis zum Boden und zurück zu gestreckten Armen, mit vollem Körpergewicht: das Ziel dieses Skills."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Head down to the floor and back up to straight arms, with your full bodyweight: the goal of this skill."
          }
        }
      }
    },
    "goal.handstandPushUp.stage5.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schultern, Trizeps, obere Brust, Rumpf"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shoulders, triceps, upper chest, core"
          }
        }
      }
    },
    "goal.lSit30.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dreißig Sekunden im Stütz mit gestreckten Beinen vor dem Körper. Baut Kompressionskraft und stabile Schultern auf, die Basis für viele Turnelemente."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thirty seconds in support with straight legs held in front. Builds compression strength and stable shoulders, the base for many gymnastics skills."
          }
        }
      }
    },
    "goal.lSit30.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hüftbeuger, Bauch, Trizeps, Schultern"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hip flexors, abs, triceps, shoulders"
          }
        }
      }
    },
    "goal.lSit30.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-Sit 30 s"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-sit 30 s"
          }
        }
      }
    },
    "goal.muscleUp.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus dem Hang unter der Stange in einer Bewegung in den Stütz darüber. Verbindet explosives Ziehen und Drücken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From hanging below the bar to support above it in one movement. Combines explosive pulling and pushing."
          }
        }
      }
    },
    "goal.muscleUp.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latissimus, Bizeps, Brust, Trizeps, Schultern, Rumpf"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lats, biceps, chest, triceps, shoulders, core"
          }
        }
      }
    },
    "goal.muscleUp.name" : {
      "extractionState" : "manual",
      "localizations" : {
