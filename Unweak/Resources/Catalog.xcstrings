          }
        }
      }
    },
    "goal.plank5Min.benefit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fünf Minuten im geraden Unterarmstütz. Baut Ausdauer im Rumpf auf, verbessert die Haltung und schützt den unteren Rücken im Alltag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Five minutes in a straight forearm plank. Builds endurance in the trunk, improves posture and protects the lower back in everyday life."
          }
        }
      }
    },
    "goal.plank5Min.muscles" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
