        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pike push-up"
          }
        }
      }
    },
    "exercise.pikePushUp.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lauf mit den Füßen heran, bis die Hüfte hoch ist und der Körper ein umgekehrtes V bildet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walk your feet in until your hips are high and your body forms an upside-down V."
          }
        }
      }
    },
    "exercise.pikePushUp.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beug die Ellbogen und senk den Kopf vor den Händen Richtung Boden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bend your elbows and lower the top of your head towards the floor in front of your hands."
          }
        }
      }
    },
    "exercise.pikePushUp.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drück dich zurück zu gestreckten Armen, die Hüfte bleibt oben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push back up to straight arms, keeping your hips high."
          }
        }
      }
    },
